  <ItemGroup>
    <EmbeddedResource Include="Icons\*.png" LogicalName="Purr.Icons.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CatLib\CatLib.csproj" Private="false" />
  </ItemGroup>
</Project>
