<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Purr</AssemblyName>
    <RootNamespace>Purr</RootNamespace>
    <Version>0.1.0</Version>
    <PluginGuid>catlib.purr</PluginGuid>
    <PluginMetaName>Purr!</PluginMetaName>
    <CatLibDeployFolder>Purr</CatLibDeployFolder>
