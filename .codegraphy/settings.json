{
  "version": 4,
  "maxFiles": 1000,
  "verboseDiagnostics": false,
  "include": [
    "**/*"
  ],
  "respectGitignore": true,
  "plugins": [
    {
      "id": "codegraphy.markdown",
      "activation": "inherit"
    }
  ],
  "interfaces": [
    {
      "id": "codegraphy.extension",
      "data": {
        "showOrphans": true,
        "showFps": false,
        "showMinimap": true,
        "cssSnippets": {},
        "nodeColors": {
          "file": "#A1A1AA",
          "folder": "#A1A1AA",
          "package": "#F59E0B",
          "symbol": "#7C3AED",
          "symbol:function": "#8B5CF6",
          "symbol:namespace": "#64748B",
          "symbol:callable": "#8B5CF6",
          "symbol:method": "#A855F7",
          "symbol:constructor": "#C084FC",
          "symbol:prototype": "#A78BFA",
          "symbol:class": "#3B82F6",
          "symbol:mixin": "#2563EB",
          "symbol:extension": "#4F46E5",
          "symbol:interface": "#06B6D4",
          "symbol:record": "#6366F1",
          "symbol:delegate": "#10B981",
          "symbol:property": "#84CC16",
          "symbol:event": "#F97316",
          "symbol:type": "#EC4899",
          "symbol:struct": "#0EA5E9",
          "symbol:union": "#14B8A6",
          "symbol:enum": "#F59E0B",
          "symbol:typedef": "#F472B6",
          "symbol:alias": "#F472B6",
          "symbol:template": "#C084FC",
          "variable": "#14B8A6",
          "variable:plain": "#14B8A6",
          "symbol:constant": "#22C55E",
          "symbol:global": "#0D9488",
          "symbol:field": "#84CC16",
          "symbol:parameter": "#2DD4BF",
          "symbol:local": "#10B981"
        },
        "favorites": [],
        "bidirectionalEdges": "separate",
        "legend": [],
        "legendVisibility": {},
        "legendOrder": [],
        "showLabels": true,
        "directionMode": "arrows",
        "directionColor": "#475569",
        "particleSpeed": 0.005,
        "particleSize": 4,
        "depthMode": false,
        "depthLimit": 1,
        "nodeSizeMode": "connections",
        "physics": {
          "repelForce": 10,
          "linkDistance": 80,
          "linkForce": 1,
          "damping": 0.4,
          "centerForce": 0.1
        }
      }
    }
  ],
  "pluginData": {},
  "nodeVisibility": {
    "file": true,
    "folder": false,
    "package": false,
    "symbol": false,
    "symbol:function": false,
    "symbol:namespace": false,
    "symbol:callable": false,
    "symbol:method": false,
    "symbol:constructor": false,
    "symbol:prototype": false,
    "symbol:class": false,
    "symbol:mixin": false,
    "symbol:extension": false,
    "symbol:interface": false,
    "symbol:record": false,
    "symbol:delegate": false,
    "symbol:property": false,
    "symbol:event": false,
    "symbol:type": false,
    "symbol:struct": false,
    "symbol:union": false,
    "symbol:enum": false,
    "symbol:typedef": false,
    "symbol:alias": false,
    "symbol:template": false,
    "variable": false,
    "variable:plain": false,
    "symbol:constant": false,
    "symbol:global": false,
    "symbol:field": false,
    "symbol:parameter": false,
    "symbol:local": false
  },
  "edgeVisibility": {
    "include": true,
    "import": true,
    "using": true,
    "nests": true,
    "call": false,
    "contains": false,
    "event": false,
    "implements": false,
    "inherit": false,
    "load": false,
    "overrides": false,
    "reexport": false,
    "reference": false,
    "type": false,
    "type-import": false
  },
  "filterPatterns": [],
  "disabledCustomFilterPatterns": [],
  "disabledPluginFilterPatterns": []
}
