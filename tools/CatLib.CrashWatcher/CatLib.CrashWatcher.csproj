<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <TargetFramework Condition="'$(CatLibWatcherCheck)' == 'true'">net8.0</TargetFramework>
    <AssemblyName>CatLib.CrashWatcher</AssemblyName>
    <RootNamespace>CatLib.CrashWatcher</RootNamespace>
    <Version>0.6.0</Version>
    <UseGameReferences>false</UseGameReferences>
    <CatLibDeployFolder>CatLib</CatLibDeployFolder>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <NoWarn Condition="'$(CatLibWatcherCheck)' == 'true'">$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\CatLib\Diagnostics\CrashSession.cs" Link="Shared\CrashSession.cs" />
    <Compile Include="..\..\src\CatLib\Diagnostics\CrashText.cs" Link="Shared\CrashText.cs" />
    <Compile Include="..\..\src\CatLib\Diagnostics\CrashStrings.cs" Link="Shared\CrashStrings.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(CatLibWatcherCheck)' == 'true' and '$(CatLibWatcherEventLogReference)' != ''">
    <Reference Include="System.Diagnostics.EventLog" HintPath="$(CatLibWatcherEventLogReference)" />
  </ItemGroup>
</Project>
